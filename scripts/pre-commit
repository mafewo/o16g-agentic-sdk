#!/usr/bin/env bash
# o16g Pre-commit Hook
# Ensures that the .o16g_state.md (REASONS Canvas) exists and isn't empty before allowing a commit.

STATE_FILE=".o16g_state.md"

if [ ! -f "$STATE_FILE" ]; then
    echo "🚨 [o16g] ERROR: The $STATE_FILE does not exist."
    echo "Run 'bash scripts/bootstrap.sh' or 'o16g init' to generate it."
    exit 1
fi

if [ ! -s "$STATE_FILE" ]; then
    echo "🚨 [o16g] ERROR: The $STATE_FILE is empty."
    echo "You must define your intention before committing."
    exit 1
fi

echo "✅ [o16g] State Canvas validation passed."
exit 0
